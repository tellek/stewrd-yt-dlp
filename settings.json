{
  "category": "Utilities",
  "version": "0.1.0",

  "outputTemplate": "%(title)s [%(id)s].%(ext)s",
  "format": "bestvideo+bestaudio/best",
  "downloadPlaylists": false,
  "playlistItems": "",

  "audioOnly": false,
  "audioFormat": "mp3",

  "embedThumbnail": true,
  "embedMetadata": true,
  "embedChapters": false,

  "subtitles": {
    "write": false,
    "writeAutoGenerated": false,
    "languages": "en.*",
    "embed": true
  },

  "sponsorBlock": {
    "mode": "off",
    "categories": ["sponsor"]
  },

  "downloadArchiveEnabled": false,
  "rateLimit": "",
  "concurrentFragments": 1,
  "retries": 10,
  "sleepBetweenDownloadsSeconds": 3,
  "cookiesFromBrowser": "",
  "proxy": "",

  "extraArgs": [],
  "autoUpdateCheckOnStartup": true
}
